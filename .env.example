# ==============================================================================
# aicc — Environment Variables & API Keys Template
# ------------------------------------------------------------------------------
# Run `setup.bat` to automatically generate your ~/.aicc/.env file.
# Alternatively, copy this file to:
#   1. %USERPROFILE%\.aicc\.env (Recommended for global usage)
#   2. .env in the aicc folder
# ==============================================================================

# OpenAI API Key (Required for Codex CLI / OpenAI model integration)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Required for Claude Code CLI / Anthropic model integration)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: Custom API Base URLs
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
